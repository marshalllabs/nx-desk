# Copy to .env for local builds. In CI, set this as a GitHub Actions secret.

# Public GitHub Releases API URL, used to detect and download app updates
NX_DESK_RELEASES_URL=

# Optional User-Agent for requests; blank uses Mozilla/5.0.
NX_DESK_USER_AGENT=

# Raw gist link of switch-ports.json, read by the Switch Ports tab; optional for builds
NX_DESK_PORTS_URL=

# Optional link to homebrews.json from nx-index
NX_DESK_HOMEBREWS_URL=

# Raw gist link of title-ids.json from nx-index, read by the Title IDs tab
NX_DESK_TITLE_IDS_URL=
